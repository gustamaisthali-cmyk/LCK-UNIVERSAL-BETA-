    {"Brick", "rbxassetid://7546648254"}, {"Granite", "rbxassetid://7547164400"}
}

local function runCustomTexturing()
    pcall(function()
        for _, part in ipairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                for _, mat in ipairs(materialTextures) do
                    if part.Material.Name == mat[1] then
                        applyTextureToPart(part, mat[2])
                        break
                    end
                end
            end
        end
    end)
end

