        local function commitValue(v)
            box.Text = tostring(v)
            onValueChanged(v)
        end

        box.FocusLost:Connect(function()
            local n = tonumber(box.Text)
            if n then commitValue(n) end
        end)

        applyBtn.MouseButton1Click:Connect(function()
            local n = tonumber(box.Text)
            if n then commitValue(n) end
        end)

        upBtn.MouseButton1Click:Connect(function()
            local cur = tonumber(box.Text) or initialVal
            commitValue(cur + stepVal)
        end)

        downBtn.MouseButton1Click:Connect(function()
            local cur = tonumber(box.Text) or initialVal
            commitValue(math.max(1, cur - stepVal))
        end)

        local infOn = false
        infBtn.MouseButton1Click:Connect(function()
            infOn = not infOn
            infBtn.Text = infOn and "INF: ON" or "INF: OFF"
            infBtn.BackgroundColor3 = infOn and Color3.fromRGB(25, 70, 35) or Color3.fromRGB(45, 30, 22)
            onInfToggle(infOn, box)
        end)
