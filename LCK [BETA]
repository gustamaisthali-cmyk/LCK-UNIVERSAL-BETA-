        StarterGui:SetCore("SendNotification", {
            Title = title or SCRIPT_NAME,
            Text = desc or "",
            Duration = duration or 4,
        })
    end)
end

local function GetHWID()
    local hwid = "MOBILE-USER-" .. tostring(LocalPlayer.UserId)
    pcall(function()
