    local GetKeyBtn = Instance.new("TextButton", RightBox)
    GetKeyBtn.Size, GetKeyBtn.Position = UDim2.fromOffset(BtnW, BtnH), UDim2.fromOffset(8 + BtnW + Gap, BtnY)
    GetKeyBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
    GetKeyBtn.Text, GetKeyBtn.TextColor3 = "Get Key", Color3.fromRGB(20, 14, 10)
    GetKeyBtn.Font, GetKeyBtn.TextSize = Enum.Font.GothamBold, 10
    Instance.new("UICorner", GetKeyBtn).CornerRadius = UDim.new(0, 6)

    local EnterKeyBtn = Instance.new("TextButton", RightBox)
    EnterKeyBtn.Size, EnterKeyBtn.Position = UDim2.fromOffset(BtnW, BtnH), UDim2.fromOffset(8 + (BtnW + Gap) * 2, BtnY)
    EnterKeyBtn.BackgroundColor3 = Color3.fromRGB(180, 90, 0)
    EnterKeyBtn.Text, EnterKeyBtn.TextColor3 = "Enter Key", Color3.fromRGB(255, 255, 255)
    EnterKeyBtn.Font, EnterKeyBtn.TextSize = Enum.Font.GothamBold, 10
    Instance.new("UICorner", EnterKeyBtn).CornerRadius = UDim.new(0, 6)

    local panelOpen = false
    local OptionPanel = Instance.new("Frame", RightBox)
    OptionPanel.Size = UDim2.fromOffset(BtnW + 24, 58)
    OptionPanel.Position = UDim2.fromOffset(8 + BtnW + Gap - 12, BtnY - 62)
    OptionPanel.BackgroundColor3 = Color3.fromRGB(40, 30, 22)
    OptionPanel.Visible = false
    OptionPanel.ZIndex = 25
    Instance.new("UICorner", OptionPanel).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", OptionPanel).Color = Color3.fromRGB(255, 140, 0)

    local function makeLinkOption(text, yPos, link)
        local optBtn = Instance.new("TextButton", OptionPanel)
        optBtn.Size, optBtn.Position = UDim2.new(1, -6, 0, 24), UDim2.fromOffset(3, yPos)
        optBtn.BackgroundColor3 = Color3.fromRGB(60, 42, 30)
        optBtn.Text, optBtn.TextColor3 = text, Color3.fromRGB(255, 200, 150)
        optBtn.Font, optBtn.TextSize = Enum.Font.GothamBold, 9
        optBtn.ZIndex = 26
        Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 4)
        optBtn.MouseButton1Click:Connect(function()
            pcall(function()
                if typeof(setclipboard) == "function" then
                    setclipboard(link)
                end
            end)
            StatusLbl.Text, StatusLbl.TextColor3 = "Link Copiado!", Color3.fromRGB(105, 195, 255)
            OptionPanel.Visible, panelOpen = false, false
        end)
    end

    makeLinkOption("Option 1 (Lootlabs)", 3, API_CONFIG.KEY_LINKS.Lootlabs)
    makeLinkOption("Option 2 (Linkvertise)", 30, API_CONFIG.KEY_LINKS.Linkvertise)

    GetKeyBtn.MouseButton1Click:Connect(function()
        panelOpen = not panelOpen
        OptionPanel.Visible = panelOpen
    end)

    FreeVersionBtn.MouseButton1Click:Connect(function()
        StatusLbl.Text, StatusLbl.TextColor3 = "Free Version Ativa!", Color3.fromRGB(0, 255, 100)
        task.wait(0.4)
        SG:Destroy()
        LaunchSUSHub(false)
    end)

    EnterKeyBtn.MouseButton1Click:Connect(function()
        local entered = KeyInput.Text:gsub("%s+", "")
        local isValid = false

        for _, key in ipairs(API_CONFIG.VALID_KEYS) do
            if entered == key then
                isValid = true
                break
            end
        end

        if isValid then
            StatusLbl.Text, StatusLbl.TextColor3 = "Key Valida! Carregando...", Color3.fromRGB(0, 255, 100)
            task.wait(0.5)
            SG:Destroy()
            LaunchSUSHub(true)
        else
            StatusLbl.Text, StatusLbl.TextColor3 = "Key Invalida!", Color3.fromRGB(255, 80, 80)
        end
    end)
end

ShowKeySystem()
