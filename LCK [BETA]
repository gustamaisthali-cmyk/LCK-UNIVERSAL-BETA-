    -- 1) Speed + controle embaixo
    createCard(PlayerFrame, "Speed (Velocidade)", "Ajuste pelo campo ou setas ▲ / ▼ embaixo", 34, Color3.fromRGB(90, 235, 110), nil)
    createSubControl(PlayerFrame, 90, walkSpeedVal, 10, function(val)
