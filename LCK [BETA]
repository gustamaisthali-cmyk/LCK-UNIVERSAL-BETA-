local function stackTexturesOnCharacter(id1, id2)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if not torso then return end

        local oldGui = torso:FindFirstChild("StackedTexGui")
        if oldGui then oldGui:Destroy() end

        local sg = Instance.new("SurfaceGui")
        sg.Name = "StackedTexGui"
        sg.Face = Enum.NormalId.Front
        sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        sg.PixelsPerStud = 50
        sg.Parent = torso

        local img1 = Instance.new("ImageLabel")
        img1.Size = UDim2.fromScale(1, 1)
        img1.BackgroundTransparency = 1
        img1.Image = id1
        img1.ZIndex = 1
        img1.Parent = sg

        local img2 = Instance.new("ImageLabel")
        img2.Size = UDim2.fromScale(1, 1)
        img2.BackgroundTransparency = 1
        img2.Image = id2
        img2.ZIndex = 2
        img2.Parent = sg
    end)
    Notify("Texturas Empilhadas", "Efeito aplicado no personagem!", 2)
end

