    end

    local tabs = {
        {btn = MainTabBtn,    frame = MainFrame,    locked = false},
        {btn = InfoTabBtn,    frame = InfoFrame,    locked = false},
        {btn = TexturaTabBtn, frame = TexturaFrame, locked = false},
        {btn = PlayerTabBtn,  frame = PlayerFrame,  locked = false},
        {btn = PremiumTabBtn, frame = PremiumFrame, locked = not isPremium},
    }

    local function setActiveTab(activeItem)
        if activeItem.locked then
            Notify("Bloqueado", "Essa aba precisa de Key / versao paga!", 3)
        end
        for _, item in ipairs(tabs) do
            item.frame.Visible = false
            if item.locked then
                item.btn.BackgroundColor3 = Color3.fromRGB(48, 22, 22)
                item.btn.TextColor3 = Color3.fromRGB(255, 120, 120)
            else
                item.btn.BackgroundColor3 = COLORS.tabIdle
                item.btn.TextColor3 = COLORS.text
            end
        end
        activeItem.frame.Visible = true
        if activeItem.locked then
            activeItem.btn.BackgroundColor3 = Color3.fromRGB(150, 35, 35)
            activeItem.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            activeItem.btn.BackgroundColor3 = COLORS.accent
            activeItem.btn.TextColor3 = Color3.fromRGB(18, 12, 8)
        end
    end

    for _, item in ipairs(tabs) do
        item.btn.MouseButton1Click:Connect(function()
            setActiveTab(item)
        end)
    end

    setActiveTab(tabs[1])
    Notify(SCRIPT_NAME, "Carregado com sucesso!", 3)
end

