local faces = {"Front", "Back", "Bottom", "Top", "Right", "Left"}
local function applyTextureToPart(part, textureId)
    pcall(function()
        for _, face in ipairs(faces) do
            local tex = Instance.new("Texture")
            tex.Texture = textureId
            tex.Face = Enum.NormalId[face]
            tex.Color3 = part.Color
            tex.Transparency = part.Transparency
            tex.Parent = part
        end
    end)
end

local minecraftMaterials = {
    {"Wood", "rbxassetid://3258599312"}, {"WoodPlanks", "rbxassetid://8676581022"},
    {"Brick", "rbxassetid://8558400252"}, {"Cobblestone", "rbxassetid://5003953441"},
    {"Concrete", "rbxassetid://7341687607"}, {"DiamondPlate", "rbxassetid://6849247561"},
    {"Fabric", "rbxassetid://118776397"}, {"Granite", "rbxassetid://4722586771"},
    {"Grass", "rbxassetid://4722588177"}, {"Ice", "rbxassetid://3823766459"},
    {"Marble", "rbxassetid://62967586"}, {"Metal", "rbxassetid://62967586"},
    {"Sand", "rbxassetid://152572215"}
}

local function runMinecraftTexturing()
    pcall(function()
        for _, part in ipairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                for _, mat in ipairs(minecraftMaterials) do
                    if part.Material.Name == mat[1] then
                        applyTextureToPart(part, mat[2])
                        part.Material = Enum.Material.SmoothPlastic
                        break
                    end
                end
            end
        end
    end)
end

local materialTextures = {
    {"Grass", "rbxassetid://7547167347"}, {"Stone", "rbxassetid://7546651802"},
    {"Concrete", "rbxassetid://7546653328"}, {"Wood", "rbxassetid://7547190453"},
    {"Sand", "rbxassetid://7547294684"}, {"Ice", "rbxassetid://7546644642"},
    {"Marble", "rbxassetid://7547174345"}, {"Metal", "rbxassetid://7547178395"},
    {"Brick", "rbxassetid://7546648254"}, {"Granite", "rbxassetid://7547164400"}
}

local function runCustomTexturing()
    pcall(function()
        for _, part in ipairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                for _, mat in ipairs(materialTextures) do
                    applyTextureToPart(part, mat[2])
                    break
                end
            end
        end
    end)
end

local function applyTextureName(textureId)
