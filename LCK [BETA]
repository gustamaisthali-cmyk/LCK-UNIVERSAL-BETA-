end

local function GetHWID()
    local hwid = "MOBILE-USER-" .. tostring(LocalPlayer.UserId)
    pcall(function()
        if typeof(gethwid) == "function" then
            local fetched = gethwid()
            if fetched and tostring(fetched) ~= "" then
                hwid = tostring(fetched)
            end
        end
    end)
    return hwid
end

