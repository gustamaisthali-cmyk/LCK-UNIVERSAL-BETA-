        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")

        if flying then
            if not hrp or not hum then flying = false return end
            local oldBg = hrp:FindFirstChild("FlyGyro")
            if oldBg then oldBg:Destroy() end
            local oldBv = hrp:FindFirstChild("FlyVel")
            if oldBv then oldBv:Destroy() end

            local bg = Instance.new("BodyGyro")
            bg.Name, bg.P, bg.MaxTorque, bg.CFrame = "FlyGyro", 9e4, Vector3.new(9e9, 9e9, 9e9), hrp.CFrame
            bg.Parent = hrp

            local bv = Instance.new("BodyVelocity")
            bv.Name, bv.Velocity, bv.MaxForce = "FlyVel", Vector3.zero, Vector3.new(9e9, 9e9, 9e9)
            bv.Parent = hrp

            hum.PlatformStand = true
        else
            if hrp then
                local bg = hrp:FindFirstChild("FlyGyro")
                local bv = hrp:FindFirstChild("FlyVel")
                if bg then bg:Destroy() end
                if bv then bv:Destroy() end
            end
            if hum then hum.PlatformStand = false end
        end
    end

    RunService.RenderStepped:Connect(function()
        if flying and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            local bv = hrp and hrp:FindFirstChild("FlyVel")
            local bg = hrp and hrp:FindFirstChild("FlyGyro")
            local cam = workspace.CurrentCamera

            if hrp and hum and bv and cam then
                local dir = hum.MoveDirection
                local flyDir = cam.CFrame:VectorToWorldSpace(Vector3.new(dir.X, 0, dir.Z))
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    flyDir += Vector3.new(0, 1, 0)
                elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                    flyDir -= Vector3.new(0, 1, 0)
                end
                local velAtual = infFlyActive and 300 or flySpeed
                bv.Velocity = flyDir * velAtual
                if bg then bg.CFrame = cam.CFrame end
            end
        end
    end)

