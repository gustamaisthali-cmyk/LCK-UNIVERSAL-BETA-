        titleLbl.Position = UDim2.fromOffset(10, 4)
        titleLbl.BackgroundTransparency = 1
        titleLbl.Text = labelText
        titleLbl.TextColor3 = COLORS.text
        titleLbl.Font = Enum.Font.GothamBold
        titleLbl.TextSize = 10
        titleLbl.TextXAlignment = Enum.TextXAlignment.Left

        local numBox = Instance.new("TextBox", row)
        numBox.Size = UDim2.fromOffset(64, 20)
        numBox.Position = UDim2.new(0.66, 0, 0, 4)
        numBox.BackgroundColor3 = Color3.fromRGB(14, 10, 8)
        numBox.Text = tostring(defaultVal)
        numBox.TextColor3 = Color3.fromRGB(255, 170, 75)
        numBox.Font = Enum.Font.GothamBold
        numBox.TextSize = 10
        numBox.ClearTextOnFocus = false
        Instance.new("UICorner", numBox).CornerRadius = UDim.new(0, 4)

        local useBtn = Instance.new("TextButton", row)
        useBtn.Size = UDim2.fromOffset(68, 20)
        useBtn.Position = UDim2.new(0.83, 0, 0, 4)
        useBtn.BackgroundColor3 = Color3.fromRGB(90, 235, 110)
        useBtn.Text = "Usar"
        useBtn.TextColor3 = Color3.fromRGB(15, 12, 10)
        useBtn.Font = Enum.Font.GothamBold
        useBtn.TextSize = 10
        Instance.new("UICorner", useBtn).CornerRadius = UDim.new(0, 4)

        local track = Instance.new("Frame", row)
        track.Size = UDim2.new(1, -20, 0, 14)
        track.Position = UDim2.fromOffset(10, 32)
        track.BackgroundColor3 = Color3.fromRGB(38, 27, 20)
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame", track)
        local pctInit = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)
        fill.Size = UDim2.new(pctInit, 0, 1, 0)
        fill.BackgroundColor3 = COLORS.accent
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local currentVal = defaultVal

        local function setByValue(v)
            currentVal = math.clamp(math.floor(v + 0.5), minVal, maxVal)
            local p = (currentVal - minVal) / (maxVal - minVal)
            fill.Size = UDim2.new(p, 0, 1, 0)
            numBox.Text = tostring(currentVal)
        end

        local draggingSlider = false
        local function updateFromInput(inputPos)
            local relX = math.clamp((inputPos.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            setByValue(minVal + relX * (maxVal - minVal))
        end

        track.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = true
                updateFromInput(i.Position)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = false
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if draggingSlider and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                updateFromInput(i.Position)
            end
        end)

        numBox.FocusLost:Connect(function()
            local n = tonumber(numBox.Text)
            if n then setByValue(n) end
        end)

        useBtn.MouseButton1Click:Connect(function()
            local n = tonumber(numBox.Text) or currentVal
            setByValue(n)
            onApply(currentVal)
        end)
    end

