local faces = {"Front", "Back", "Bottom", "Top", "Right", "Left"}

local function applyTextureToPart(part, textureId)
    pcall(function()
        for _, face in ipairs(faces) do
            local tex = Instance.new("Texture")
            tex.Texture = textureId
            tex.Face = Enum.NormalId[face]
            tex.Color3 = part.Color
            tex.Transparency = part.Transparency
            tex.Parent = part
        end
    end)
end

