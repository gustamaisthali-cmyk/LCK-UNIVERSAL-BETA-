local function createSlider(tabName, labelText, min, max, default, callback)
	local parentPage = pages[tabName]
	if not parentPage then return end

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -6, 0, 45)
	frame.BackgroundColor3 = Color3.fromRGB(22, 18, 32)
	frame.BackgroundTransparency = 0.3
	frame.ZIndex = 2
	frame.Parent = parentPage
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -10, 0, 20)
	lbl.Position = UDim2.fromOffset(6, 4)
	lbl.BackgroundTransparency = 1
	lbl.Text = "  " .. labelText .. ": " .. default
	lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 11
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = 2
	lbl.Parent = frame

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0, 80, 0, 18)
	box.Position = UDim2.new(1, -86, 0, 4)
	box.BackgroundColor3 = Color3.fromRGB(35, 25, 48)
	box.Text = tostring(default)
	box.TextColor3 = Color3.new(1, 1, 1)
	box.Font = Enum.Font.GothamBold
	box.TextSize = 11
	box.ZIndex = 3
	box.Parent = frame
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

	box.FocusLost:Connect(function()
		local val = tonumber(box.Text)
		if val then
			val = math.clamp(val, min, max)
			box.Text = tostring(val)
			lbl.Text = "  " .. labelText .. ": " .. val
			if callback then callback(val) end
		else
			box.Text = tostring(default)
		end
	end)
end

