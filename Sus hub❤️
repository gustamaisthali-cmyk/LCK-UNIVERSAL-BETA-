local function setAimbot(on)
    CombatSettings.AimbotEnabled = on
    if aimbotConn then aimbotConn:Disconnect() aimbotConn = nil end
    if not on then
        if targetHighlight then targetHighlight:Destroy(); targetHighlight = nil end
        return
    end

    aimbotConn = RunService.RenderStepped:Connect(function(dt)
        local cam = workspace.CurrentCamera
        local targetPart = nil
        local targetPlr = nil

        if CombatSettings.FocusMode == "Focus Target" and CombatSettings.SelectedTarget ~= "Nenhum" then
            targetPlr = Players:FindFirstChild(CombatSettings.SelectedTarget)
            if targetPlr and targetPlr.Character then
                targetPart = targetPlr.Character:FindFirstChild("HumanoidRootPart") or targetPlr.Character:FindFirstChild("Head")
            end
        elseif CombatSettings.FocusMode == "Focus All" then
            local closest, dist = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        local d = (cam.CFrame.Position - hrp.Position).Magnitude
                        if d < dist then dist = d; closest = hrp; targetPlr = p end
                    end
                end
            end
            targetPart = closest
        end

        if targetPlr then updateTargetIndicator(targetPlr)
        else
            if targetHighlight then targetHighlight:Destroy(); targetHighlight = nil end
        end

        if targetPart then
            local targetCFrame = CFrame.new(cam.CFrame.Position, targetPart.Position)
            if CombatSettings.CameraShakeOff then
                local alpha = math.clamp(dt * (CombatSettings.CameraSmoothness * 4), 0.05, 1)
                cam.CFrame = cam.CFrame:Lerp(targetCFrame, alpha)
            else
                cam.CFrame = targetCFrame
            end
        end
    end)
end

