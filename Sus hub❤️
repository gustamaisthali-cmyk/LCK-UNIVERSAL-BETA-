        StatsLabel.Text = string.format("FPS: %d | Ping: %dms", math.floor(1 / task.wait()), math.clamp(ping,1,999))
    end)

    local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
    local Window = WindUI:CreateWindow({Title = "SUS HUB | Eu ❤️ sua mãe v1.0", Icon = "eye", Author = "Comunidade", Folder = "SUS_CONFIG", Size = UDim2.fromOffset(550, 420), Theme = "Dark", Transparent = true, OpenButton = {Enabled = true, Draggable = true}})

    local statusText = isPremiumUser and "🟢 Script Premium" or "🟠 Script Grátis"
    local InfoTab = Window:Tab({Title = "Informações", Icon = "info"})
    local Tab2 = Window:Tab({Title = "FARM", Icon = "layout"})
    local Tab3 = Window:Tab({Title = "CONFIG", Icon = "settings"})
    local Tab4 = Window:Tab({Title = "ESP", Icon = "eye"})
    local Tab5 = Window:Tab({Title = "JOGADOR", Icon = "user"})
    local Tab6 = Window:Tab({Title = isPremiumUser and "COMBAT" or "COMBAT 🔒", Icon = "sliders"})
    local Tab7 = Window:Tab({Title = "TP", Icon = "map"})
    local FlingTab = Window:Tab({Title = isPremiumUser and "FLING" or "FLING 🔒", Icon = "zap"})
    local DanceTab = Window:Tab({Title = "DANÇAS", Icon = "music"})
    local CmdTab = Window:Tab({Title = "COMANDOS", Icon = "terminal"})

    InfoTab:Section({Title = "STATUS DO SISTEMA"})
    InfoTab:Paragraph({Title = "Versão Atual", Desc = statusText .. " | Jogador: " .. LocalPlayer.Name})
    InfoTab:Paragraph({Title = "Discord Oficial", Desc = API_CONFIG.DISCORD_INVITE})
    InfoTab:Section({Title = "CHANGELOG"})
    InfoTab:Paragraph({Title = "v1.0 Lançamento", Desc = "• ESP Inteligente MM2\n• Aba de Danças e Emotes\n• Tema Laranja e Amarelo\n• Modo Grátis / Premium ativado"})

    Tab2:Section({Title = "FARM"})
    Tab2:Toggle({Title = "Auto Farm", Default = false, Callback = function(s) States.AutoFarm = s end})

    Tab3:Section({Title = "CONFIGURAÇÕES"})
    Tab3:Toggle({Title = "Anti AFK", Default = false, Callback = function(s) setAntiAFK(s) end})
    Tab3:Toggle({Title = "Noclip", Default = false, Callback = function(s) setNoclip(s) end})
    Tab3:Toggle({Title = "Inf Jump", Default = false, Callback = function(s) setInfJump(s) end})
    Tab3:Toggle({Title = "Fullbright", Default = false, Callback = function(s) setFullbright(s) end})
    Tab3:Toggle({Title = "Xray", Default = false, Callback = function(s) setXray(s) end})

    Tab4:Section({Title = "ESP INTELIGENTE"})
    Tab4:Toggle({Title = "Ativar ESP", Default = false, Callback = function(s) setESP(s) end})
    Tab4:Toggle({Title = "Mostrar Inocentes", Default = true, Callback = function(s) States.ShowInnocents = s end})

    Tab5:Section({Title = "PERSONAGEM"})
    Tab5:Toggle({Title = "Velocidade Custom", Default = false, Callback = function(s) States.Speed = s end})
    Tab5:Slider({Title = "Velocidade", Value = {Min = 16, Max = 200, Default = 16}, Callback = function(v) Settings.Speed = v end})
    Tab5:Toggle({Title = "Pulo Custom", Default = false, Callback = function(s) States.Jump = s end})
    Tab5:Slider({Title = "Pulo", Value = {Min = 50, Max = 250, Default = 50}, Callback = function(v) Settings.JumpPower = v end})
    Tab5:Toggle({Title = "Fly", Default = false, Callback = function(s) setFly(s) end})
    Tab5:Slider({Title = "Velocidade do Fly", Value = {Min = 10, Max = 300, Default = 60}, Callback = function(v) Settings.FlySpeed = v end})
    Tab5:Toggle({Title = "Spin", Default = false, Callback = function(s) setSpin(s) end})

    Tab6:Section({Title = "COMBAT"})
    Tab6:Toggle({Title = "Aimbot / Camera Lock", Default = false, Callback = function(s) setAimbot(s) end})
    Tab6:Toggle({Title = "Aura de Fogo", Default = false, Callback = function(s) setFireAura(s) end})

    Tab7:Section({Title = "TELEPORTE"})
    local plist = {"Nenhum"} for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then table.insert(plist, p.Name) end end
    Tab7:Dropdown({Title = "Ir para jogador", Values = plist, Multi = false, Callback = function(sel) tpToPlayer(sel) end})
    Tab7:Input({Title = "Nome do Waypoint", Placeholder = "ex: base", Callback = function(v) Settings._wayName = v end})
    Tab7:Button({Title = "Salvar Posição", Callback = function() if Settings._wayName ~= "" then saveWaypoint(Settings._wayName) end end})
    Tab7:Button({Title = "Ir para Waypoint", Callback = function() gotoWaypoint(Settings._wayName) end})

    FlingTab:Section({Title = "FLING"})
    FlingTab:Button({Title = "Fling All", Callback = function() flingAll() end})
    FlingTab:Button({Title = "Parar Fling", Callback = function() stopFling() end})

    DanceTab:Section({Title = "DANÇAS E EMOTES"})
    for name, id in pairs(DANCES) do
        DanceTab:Button({Title = "Dança: " .. name, Callback = function() playCustomAnimation(id) end})
    end
    DanceTab:Button({Title = "Parar Dança", Callback = function() stopCustomAnimation() end})

    CmdTab:Section({Title = "COMANDOS"})
    CmdTab:Paragraph({Title = "Info", Desc = "Use o painel flutuante para comandos rápidos."})

    RunService.Heartbeat:Connect(function()
        local _, hum = getChar()
        if hum then
            if States.Speed then hum.WalkSpeed = Settings.Speed end
            if States.Jump then hum.JumpPower = Settings.JumpPower end
        end
    end)
end
