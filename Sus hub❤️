-- ============ ESP INTELIGENTE (UNIFICADO) ============
local espConn, espHL, espLabels = nil, {}, {}
local espLastUpdate = 0

local function getPlayerRole(player)
    if player == LocalPlayer then return nil end
    local backpack = player:FindFirstChild("Backpack")
    local char = player.Character
    local function hasTool(name)
        if char and char:FindFirstChild(name) then return true end
        if backpack and backpack:FindFirstChild(name) then return true end
        return false
    end
    if hasTool("Knife") then return "Murderer" end
    if hasTool("Gun")   then return "Sheriff"  end
    return "Innocent"
end

local function setESP(on)
    States.ESP = on
    if espConn then espConn:Disconnect() espConn = nil end
    for _, hl in pairs(espHL) do pcall(function() hl:Destroy() end) end
    for _, l in pairs(espLabels) do pcall(function() l.gui:Destroy() end) end
    espHL, espLabels = {}, {}
    
    if not on then return end

    espConn = RunService.Heartbeat:Connect(function()
        if tick() - espLastUpdate < 0.3 then return end
        espLastUpdate = tick()
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local role = getPlayerRole(plr)
                local char = plr.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local head = char and char:FindFirstChild("Head")
                
                local shouldShow = char and hum and hum.Health > 0 and (role ~= "Innocent" or States.ShowInnocents)
                
                if shouldShow then
                    -- Cria o Highlight se não existir
                    if not espHL[plr] or not espHL[plr].Parent then
                        local hl = Instance.new("Highlight")
                        hl.Name = "SUS_ESP"
                        hl.FillTransparency = 0.6
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = char
                        espHL[plr] = hl
                    end
                    
                    -- Define as cores (MM2 ou Padrão)
                    local hl = espHL[plr]
                    if role == "Murderer" then
                        hl.FillColor = Color3.fromRGB(255, 0, 0)     -- Vermelho
                        hl.OutlineColor = Color3.fromRGB(255, 150, 150)
                    elseif role == "Sheriff" then
                        hl.FillColor = Color3.fromRGB(0, 100, 255)    -- Azul
                        hl.OutlineColor = Color3.fromRGB(150, 200, 255)
                    else
                        hl.FillColor = Color3.fromRGB(0, 255, 0)      -- Verde
                        hl.OutlineColor = Color3.fromRGB(150, 255, 150)
                    end
                    
                    -- Cria o Nome flutuante
                    if head and (not espLabels[plr] or not espLabels[plr].gui.Parent) then
                        local bg = Instance.new("BillboardGui")
                        bg.Size = UDim2.fromOffset(120, 24)
                        bg.StudsOffset = Vector3.new(0, 2.5, 0)
                        bg.AlwaysOnTop = true
                        bg.Parent = head
                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.fromScale(1,1)
                        lbl.BackgroundTransparency = 1
                        lbl.TextStrokeTransparency = 0
                        lbl.Font = Enum.Font.GothamBold
                        lbl.TextSize = 14
                        lbl.Parent = bg
                        espLabels[plr] = {gui = bg, label = lbl}
                    end
                    
                    -- Atualiza o Texto
                    local info = espLabels[plr]
                    if info and info.label then
                        info.label.Text = role
                        if role == "Murderer" then info.label.TextColor3 = Color3.fromRGB(255, 50, 50)
                        elseif role == "Sheriff" then info.label.TextColor3 = Color3.fromRGB(80, 160, 255)
                        else info.label.TextColor3 = Color3.fromRGB(80, 255, 80) end
                    end
                else
                    -- Remove se morreu ou terminou a partida
                    if espHL[plr] then pcall(function() espHL[plr]:Destroy() end); espHL[plr]=nil end
                    if espLabels[plr] then pcall(function() espLabels[plr].gui:Destroy() end); espLabels[plr]=nil end
                end
            end
        end
    end)
end

