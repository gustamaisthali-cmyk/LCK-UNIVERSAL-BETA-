-- ============ EXECUTOR DE COMANDOS ============
local function executeCommand(rawText)
    local text = rawText:lower():gsub("^;",""):gsub("^/",""):gsub("^%s+",""):gsub("%s+$","")
    if text == "" then return end
    local args = {}
    for w in text:gmatch("%S+") do args[#args+1] = w end
    local cmd, arg1 = args[1], args[2]
    local num = tonumber(arg1)

    if cmd == "un" then
        local target = arg1
        if target == "fly"         then setFly(false)
        elseif target == "speed"   then States.Speed = false
        elseif target == "jump"    then States.Jump = false
        elseif target == "noclip"  then setNoclip(false)
        elseif target == "infjump" then setInfJump(false)
        elseif target == "spin"    then setSpin(false)
        elseif target == "esp"     then setESP(false)
        elseif target == "xray"    then setXray(false)
        elseif target == "fullbright" then setFullbright(false)
        elseif target == "antiafk" then setAntiAFK(false)
        elseif target == "aimbot"  then setAimbot(false)
        elseif target == "killaura"then setKillaura(false)
        elseif target == "hitbox"  then setHitbox(false)
        elseif target == "fling"   then stopFling()
        elseif target == "touchfling" then enableTouchFling(false)
        end
        return
    end

    if cmd == "fly"         then setFly(true)
    elseif cmd == "speed"   then if num then Settings.Speed = num end; States.Speed = true
    elseif cmd == "jump"    then if num then Settings.JumpPower = num end; States.Jump = true
    elseif cmd == "noclip"  then setNoclip(true)
