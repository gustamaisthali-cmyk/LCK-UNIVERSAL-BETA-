    Tab6:Slider({ Title = "Suavidade da Câmera", Value = {Min = 1, Max = 20, Default = 6}, Callback = function(v) CombatSettings.CameraSmoothness = v end })
    Tab6:Toggle({ Title = "CAMERA SHAKE OFF", Desc = "Reduz tremores e travamentos da câmera", Default = true, Callback = function(s) CombatSettings.CameraShakeOff = s end })

    Tab6:Section({ Title = "HITBOX SETTINGS" })
    Tab6:Toggle({ Title = "Hitbox Visual (Personagem Local)", Desc = "Mostra área visual do seu personagem", Default = false, Callback = function(s) CombatSettings.HitboxVisual = s; updateLocalHitbox() end })

    Tab6:Section({ Title = "FIRE AURA" })
    Tab6:Toggle({ Title = "Ativar Aura de Fogo", Desc = "Efeito visual de chamas", Default = false, Callback = function(s) setFireAura(s) end })
    Tab6:Slider({ Title = "Tamanho das Chamas", Value = {Min = 2, Max = 15, Default = 6}, Callback = function(v) CombatSettings.FireAuraSize = v; updateFireAura() end })

    Tab6:Section({ Title = "VISUAL EFFECTS" })
    Tab6:Toggle({ Title = "Indicador Visual do Alvo", Default = true, Callback = function(s) CombatSettings.TargetIndicator = s end })

    Tab7:Section({ Title = "TELEPORTE" })
    local tpPlayerList = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then tpPlayerList[#tpPlayerList+1] = p.Name end
    end
    Tab7:Dropdown({ Title="Ir para jogador", Values=tpPlayerList, Multi=false, Callback=function(sel) tpToPlayer(sel) end })
    Tab7:Button({ Title="Atualizar lista", Callback=function() WindUI:Notify({ Title="TP", Content="Recarregue o script para atualizar", Duration=3 }) end })
    Tab7:Divider()
    Tab7:Section({ Title = "WAYPOINTS" })
    Tab7:Input({ Title="Nome do waypoint", Placeholder="ex: base, spawn", Callback=function(v) Settings._wayName=v end })
    Tab7:Button({ Title="Salvar posição atual", Callback=function()
        if Settings._wayName ~= "" then saveWaypoint(Settings._wayName); WindUI:Notify({Title="Waypoint", Content="Salvo: "..Settings._wayName, Duration=3}) end
    end })
    Tab7:Button({ Title="Ir para waypoint salvo", Callback=function()
        if waypoints[Settings._wayName] then gotoWaypoint(Settings._wayName) end
    end })
    Tab7:Divider()
    Tab7:Section({ Title = "TP RÁPIDO" })
    Tab7:Button({ Title="Subir 30 studs", Callback=function() local _,_,root=getChar(); if root then root.CFrame = root.CFrame * CFrame.new(0,30,0) end end })
    Tab7:Button({ Title="Descer 30 studs", Callback=function() local _,_,root=getChar(); if root then root.CFrame = root.CFrame * CFrame.new(0,-30,0) end end })

    FlingTab:Section({ Title = "FLING" })
    FlingTab:Button({ Title="Fling All", Desc="Arremessa todos para fora do mapa", Callback=function() flingAll() end })
    FlingTab:Button({ Title="Parar Fling", Callback=function() stopFling() end })
    FlingTab:Toggle({ Title="Touch Fling", Desc="Encostar em outro jogador = arremessa", Default=false, Callback=function(s) enableTouchFling(s) end })

    DanceTab:Section({ Title = "DANÇAS E EMOTES" })
    DanceTab:Paragraph({ Title = "Nota", Desc = "Essas danças rodam localmente no seu personagem." })
    DanceTab:Button({ Title = "Dança: Floss", Callback=function() playCustomAnimation(DANCES.Floss) end })
    DanceTab:Button({ Title = "Dança: Wave", Callback=function() playCustomAnimation(DANCES.Wave) end })
    DanceTab:Button({ Title = "Dança: Lean", Callback=function() playCustomAnimation(DANCES.Lean) end })
    DanceTab:Button({ Title = "Dança: Robot", Callback=function() playCustomAnimation(DANCES.Robot) end })
    DanceTab:Button({ Title = "Dança: Zombie", Callback=function() playCustomAnimation(DANCES.Zombie) end })
    DanceTab:Button({ Title = "Dança: Macarena", Callback=function() playCustomAnimation(DANCES.Macarena) end })
    DanceTab:Button({ Title = "Dança: Hype", Callback=function() playCustomAnimation(DANCES.Hype) end })
    DanceTab:Divider()
    DanceTab:Button({ Title = "Parar Dança / Animação", Callback=function() stopCustomAnimation() end })

    CmdTab:Section({ Title = "COMO USAR" })
    CmdTab:Paragraph({ Title = "Painel", Desc = "Clique no botão ▼ no canto superior direito para abrir o chat de comandos." })

    WindUI:Notify({ Title = "SUS HUB", Content = "Interface carregada com sucesso!", Duration = 4 })

    RunService.Heartbeat:Connect(function()
        local _, hum = getChar()
        if not hum then return end
        if States.Speed then hum.WalkSpeed = Settings.Speed end
        if States.Jump  then hum.JumpPower = Settings.JumpPower end
    end)
end
