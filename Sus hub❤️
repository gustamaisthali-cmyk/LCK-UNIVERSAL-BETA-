-- ============ COMBAT ============
local combatConns = {}
local function clearCombat()
    for _, c in ipairs(combatConns) do c:Disconnect() end combatConns = {}
end

local aimbotConn
local function setAimbot(on)
    States.Aimbot = on
    if aimbotConn then aimbotConn:Disconnect() aimbotConn=nil end
    if not on then return end
    aimbotConn = RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        local closest, dist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local d = (cam.CFrame.Position - hrp.Position).Magnitude
                    if d < dist then dist = d; closest = hrp end
                end
            end
        end
        if closest then cam.CFrame = CFrame.new(cam.CFrame.Position, closest.Position) end
    end)
end

local killauraConn
local function setKillaura(on, range)
    States.Killaura = on
    if killauraConn then killauraConn:Disconnect() killauraConn=nil end
    if not on then return end
    range = range or Settings.KillRange or 20
    killauraConn = RunService.Heartbeat:Connect(function()
        local _, _, root = getChar()
        if not root then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local ihrp = p.Character:FindFirstChild("HumanoidRootPart")
                local ihum = p.Character:FindFirstChildOfClass("Humanoid")
                if ihrp and ihum and ihum.Health > 0
                and (root.Position - ihrp.Position).Magnitude <= range then
                    pcall(function()
                        firetouchinterest(root, ihrp, 0)
                        firetouchinterest(root, ihrp, 1)
                    end)
                end
            end
        end
    end)
end

local hitboxOrig = {}
local function setHitbox(on, size)
    States.Hitbox = on
    for _, hrp in pairs(hitboxOrig) do
        if hrp and hrp.Parent then pcall(function() hrp.Size = Vector3.new(2,2,1) end) end
    end
    hitboxOrig = {}
    clearCombat()
    if not on then return end
    size = size or Settings.HitboxSize or 10
    local function apply(char)
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hitboxOrig[char] = hrp
            hrp.Size = Vector3.new(size, size, size)
            hrp.Transparency = 0.7
            hrp.CanCollide = false
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then apply(p.Character) end
        table.insert(combatConns, p.CharacterAdded:Connect(apply))
    end
end

