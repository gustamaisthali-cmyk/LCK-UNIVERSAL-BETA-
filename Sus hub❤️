local aimbotConn, targetHL
local function setAimbot(on)
    if not isPremiumUser then Notify("🔒 Bloqueado", "Exige Key Premium!", Color3.fromRGB(255,140,0)) return end
    CombatSettings.AimbotEnabled = on
    if aimbotConn then aimbotConn:Disconnect() aimbotConn = nil end
    if not on then if targetHL then targetHL:Destroy(); targetHL = nil end return end
    aimbotConn = RunService.RenderStepped:Connect(function(dt)
        local cam = workspace.CurrentCamera
        local targetPart, targetPlr = nil, nil
        if CombatSettings.FocusMode == "Focus Target" and CombatSettings.SelectedTarget ~= "Nenhum" then
            targetPlr = Players:FindFirstChild(CombatSettings.SelectedTarget)
            if targetPlr and targetPlr.Character then targetPart = targetPlr.Character:FindFirstChild("HumanoidRootPart") or targetPlr.Character:FindFirstChild("Head") end
        elseif CombatSettings.FocusMode == "Focus All" then
            local dist = math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hrp, hum = p.Character:FindFirstChild("HumanoidRootPart"), p.Character:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        local d = (cam.CFrame.Position - hrp.Position).Magnitude
                        if d < dist then dist = d; targetPart = hrp; targetPlr = p end
                    end
                end
            end
        end
        if targetPlr then
            if not targetHL or targetHL.Parent ~= targetPlr.Character then
                if targetHL then targetHL:Destroy() end
                targetHL = New("Highlight", {Name = "SUS_Target", FillColor = Color3.fromRGB(255,60,0), FillTransparency = 0.4, Parent = targetPlr.Character})
            end
        else
            if targetHL then targetHL:Destroy(); targetHL = nil end
        end
        if targetPart then
            local targetCF = CFrame.new(cam.CFrame.Position, targetPart.Position)
            cam.CFrame = CombatSettings.CameraShakeOff and cam.CFrame:Lerp(targetCF, math.clamp(dt * (CombatSettings.CameraSmoothness * 4), 0.05, 1)) or targetCF
        end
    end)
end

