local function Protect(gui)
    local e = (getgenv and getgenv()) or _G
    gui.Parent = e.HIDEUI or (gethui and gethui()) or game:GetService("CoreGui")
end

local function New(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do if k ~= "Children" and k ~= "Parent" then pcall(function() inst[k] = v end) end end
    if props.Children then for _, c in ipairs(props.Children) do c.Parent = inst end end
    inst.Parent = props.Parent or parent
    return inst
end

local function SaveK(k) pcall(function() if not isfolder(FOLDER) then makefolder(FOLDER) end writefile(KFILE, HS:JSONEncode({key=k})) end) end
local function LoadK() 
    if isfolder(FOLDER) and isfile(KFILE) then
        local ok, v = pcall(function() return HS:JSONDecode(readfile(KFILE)) end)
        if ok and v and v.key then return tostring(v.key) end
    end
    return ""
end

local function CheckK(k, cb)
    task.spawn(function()
        local ok, api = pcall(function() return loadstring(game:HttpGet("https://sdkapi-public.luarmor.net/library.lua"))() end)
        if not ok or not api then cb(false); return end
        api.script_id = "0ae9fe4cf963e3a13d25eed0e2ce5940"
        local sOk, status = pcall(function() return api.check_key(k) end)
        if sOk and status and status.code == "KEY_VALID" then
            SaveK(k); isPremium = true; cb(true)
        else
            pcall(function() writefile(KFILE, HS:JSONEncode({})) end)
            isPremium = false; cb(false)
        end
    end)
end

