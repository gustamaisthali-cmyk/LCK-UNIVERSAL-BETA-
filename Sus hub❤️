local flingActive = false
local function skidFling(targetPlr)
    if not isPremiumUser then Notify("🔒 Bloqueado", "Exige Key Premium!", Color3.fromRGB(255,140,0)) return end
    local lc, lh, lr = LocalPlayer.Character, LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid"), LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local tc, th, tr = targetPlr.Character, targetPlr.Character and targetPlr.Character:FindFirstChildOfClass("Humanoid"), targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart")
    if not tc or not lr then return end
    local part = tr or tc:FindFirstChild("Head")
    if not part then return end
    local orig = workspace.FallenPartsDestroyHeight; workspace.FallenPartsDestroyHeight = 0/0
    local bv = New("BodyVelocity", {Velocity = Vector3.zero, MaxForce = Vector3.new(9e9,9e9,9e9)}, lr)
    local start, angle = tick(), 0
    repeat
        if part.Parent and lr.Parent then
            angle += 100
            local pos = CFrame.new(part.Position) * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(angle), 0, 0)
            lr.CFrame = pos; lc:SetPrimaryPartCFrame(pos)
            lr.Velocity = Vector3.new(9e7, 9e7*10, 9e7)
            lr.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
        end
        task.wait()
    until tick() - start > 2 or not flingActive
    bv:Destroy(); workspace.FallenPartsDestroyHeight = orig
end
local function flingAll()
    if not isPremiumUser then Notify("🔒 Bloqueado", "Exige Key Premium!", Color3.fromRGB(255,140,0)) return end
    flingActive = true
    task.spawn(function()
        while flingActive do
            for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer and p.Character then pcall(function() skidFling(p) end); task.wait(0.1) end end
            task.wait(0.5)
        end
    end)
end
local function stopFling() flingActive = false end

