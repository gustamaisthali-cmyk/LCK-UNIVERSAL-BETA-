local function destroyFlyObjects()
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
end

local function updateFly(hum, root)
	if not flyBV or flyBV.Parent ~= root then
		destroyFlyObjects()
		flyBV = Instance.new("BodyVelocity", root)
		flyBV.Name = "SUS_FlyVel"
		flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		flyBV.Velocity = Vector3.zero

		flyBG = Instance.new("BodyGyro", root)
		flyBG.Name = "SUS_FlyGyro"
		flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		flyBG.P = 9e4
		flyBG.D = 1e3
	end

	hum.PlatformStand = true
	local cf = workspace.CurrentCamera.CFrame
	local move = hum.MoveDirection
	local vel = Vector3.zero

	if move.Magnitude > 0.01 then
		local rel = cf:VectorToObjectSpace(move)
		rel = Vector3.new(rel.X, 0, rel.Z)
		if rel.Magnitude > 0.01 then
			vel = cf:VectorToWorldSpace(rel.Unit * math.min(move.Magnitude, 1))
		end
	end

	flyBV.Velocity = vel * Settings.FlySpeed
	if States.Spin then
		flyBG.MaxTorque = Vector3.new(9e9, 0, 9e9)
		flyBG.CFrame = CFrame.new()
	else
		flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		flyBG.CFrame = cf
	end
end

local function updateSpin(hum, root)
	local s = root:FindFirstChild("SUS_Spin")
	if not s then
		s = Instance.new("BodyAngularVelocity", root)
		s.Name = "SUS_Spin"
		s.MaxTorque = Vector3.new(0, 9e9, 0)
		s.P = 1e5
	end
	s.AngularVelocity = Vector3.new(0, Settings.SpinSpeed, 0)
	hum.AutoRotate = false
end

local function flingAllPlayers()
	local _, _, root = getChar()
	if not root then return end
	local bav = Instance.new("BodyAngularVelocity", root)
	bav.AngularVelocity = Vector3.new(99999, 99999, 99999)
	bav.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bav.Parent = root
	local oldPos = root.CFrame
	task.wait(0.6)
	bav:Destroy()
	root.CFrame = oldPos + Vector3.new(0, 5, 0)
end

local function bringAllPlayers()
	local _, _, root = getChar()
	if not root then return end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			p.Character.HumanoidRootPart.CFrame = root.CFrame + Vector3.new(math.random(-3, 3), 0, math.random(-3, 3))
		end
	end
end

local espFolder = nil
local function toggleESP(active)
	if active then
		if espFolder then espFolder:Destroy() end
		espFolder = Instance.new("Folder", workspace)
		espFolder.Name = "SUS_ESP_Folder"
		RunService.RenderStepped:Connect(function()
			if not States.ESP or not espFolder then return end
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character then
					local char = p.Character
					local hl = char:FindFirstChild("SUS_Highlight")
					if not hl then
						hl = Instance.new("Highlight", char)
						hl.Name = "SUS_Highlight"
					end
					hl.FillColor = Color3.fromRGB(0, 255, 0)
					hl.FillTransparency = 0.4
				end
			end
		end)
	else
		States.ESP = false
		if espFolder then espFolder:Destroy() espFolder = nil end
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character and p.Character:FindFirstChild("SUS_Highlight") then p.Character.SUS_Highlight:Destroy() end
		end
	end
end

local noclipConn
local function toggleNoclip(active)
	if active then
		noclipConn = RunService.Stepped:Connect(function()
			local char = getChar()
			if char then
				for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
			end
		end)
	else
		States.Noclip = false
		if noclipConn then noclipConn:Disconnect() noclipConn = nil end
	end
end

local infJumpConn
local function toggleInfJump(active)
	if active then
		infJumpConn = UserInputService.JumpRequest:Connect(function()
			local _, hum = getChar()
			if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
		end)
	else
		States.InfJump = false
		if infJumpConn then infJumpConn:Disconnect() infJumpConn = nil end
	end
end

local function toggleXray(active)
	States.Xray = active
	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("BasePart") and not v.Parent:FindFirstChildOfClass("Humanoid") then
			v.LocalTransparencyModifier = active and 0.7 or 0
		end
	end
end

local function toggleFullbright(active)
	States.Fullbright = active
	Lighting.Brightness = active and 2 or 1
	Lighting.ClockTime = 14
	Lighting.GlobalShadows = not active
end

