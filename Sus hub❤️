-- ============ FLING ============
local flingActive = false
local function skidFling(targetPlayer)
    local localChar = LocalPlayer.Character
    local localHum = localChar and localChar:FindFirstChildOfClass("Humanoid")
    local localRoot = localHum and localHum.RootPart
    local targetChar = targetPlayer.Character
    if not targetChar or not localRoot then return end
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    local targetRoot = targetHum and targetHum.RootPart
    local targetHead = targetChar:FindFirstChild("Head")
    if not targetRoot and not targetHead then return end
    local partToFling = targetRoot or targetHead
    local originalHeight = workspace.FallenPartsDestroyHeight
    workspace.FallenPartsDestroyHeight = 0/0
    local bv = Instance.new("BodyVelocity")
    bv.Parent = localRoot
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    local start = tick()
    local angle = 0
    repeat
        if partToFling and partToFling.Parent and localRoot.Parent then
            angle = angle + 100
            local offset = CFrame.new(0, 1.5, 0) + targetHum.MoveDirection * (partToFling.Velocity.Magnitude / 1.25)
            local pos = CFrame.new(partToFling.Position) * offset * CFrame.Angles(math.rad(angle), 0, 0)
            localRoot.CFrame = pos
            localChar:SetPrimaryPartCFrame(pos)
            localRoot.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
            localRoot.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
        end
        task.wait()
    until tick() - start > 2 or not flingActive
    bv:Destroy()
    workspace.FallenPartsDestroyHeight = originalHeight
end

local function flingAll()
    flingActive = true
    task.spawn(function()
        while flingActive do
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    pcall(function() skidFling(plr) end)
                    task.wait(0.1)
                end
            end
            task.wait(0.5)
        end
    end)
end
local function stopFling() flingActive = false end

local touchFlingConn
local function enableTouchFling(on)
    States.TouchFling = on
    if touchFlingConn then touchFlingConn:Disconnect() touchFlingConn=nil end
    if not on then return end
    local function attach(char)
        local hum = char:WaitForChild("Humanoid")
        hum.Touched:Connect(function(hit)
            if not States.TouchFling then return end
            local otherChar = hit:FindFirstAncestorOfClass("Model")
            if otherChar and otherChar ~= char then
                local otherPlr = Players:GetPlayerFromCharacter(otherChar)
                if otherPlr and otherPlr ~= LocalPlayer then
                    pcall(function()
                        flingActive = true
                        skidFling(otherPlr)
                        flingActive = false
                    end)
                end
            end
        end)
    end
    if LocalPlayer.Character then attach(LocalPlayer.Character) end
    touchFlingConn = LocalPlayer.CharacterAdded:Connect(attach)
end

