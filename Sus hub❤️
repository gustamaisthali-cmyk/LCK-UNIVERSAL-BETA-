local xrayOrig = {}
local function setXray(on)
    States.Xray = on
    if on then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name ~= "Terrain" then
                xrayOrig[obj] = obj.LocalTransparencyModifier
                obj.LocalTransparencyModifier = 0.7
            end
